# example.env for internship_poller.py / client/discord_bot.py — copy to .env
# (repo root) and fill in your values.
# Both scripts auto-load .env via python-dotenv (pip install python-dotenv),
# and .env values override anything already exported in the shell. For the
# poller CLI the dependency is optional — plain env vars still work without it.
#
# GEMINI_* is only needed with --llm (sweep/list/watch/llm-diff).

# Required for client/discord_bot.py (includes the /internships commands).
DISCORD_TOKEN=your-discord-bot-token-here

# Required for --llm. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Model used for classification. gemini-3.5-flash-lite is the cheap
# high-throughput default; gemini-3.6-flash is the stronger workhorse.
GEMINI_MODEL=gemini-3.5-flash-lite

# Postings per API call.
GEMINI_BATCH=25

# Rate limits — match these to your AI Studio dashboard's rate-limit view,
# since free-tier RPM/RPD vary by project.
# Models tried, in order, when the primary one's daily quota is spent. The
# free-tier daily cap is PER MODEL, so each fallback adds its own budget —
# 3.5-flash-lite + 3.1-flash-lite is ~1000 requests/day instead of 500.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash

# flash-lite free tier: 15 RPM / 500 RPD / 250k TPM.
# flash free tier is lower — 5 RPM / 250 RPD — so lower these if you switch
# GEMINI_MODEL to a flash model.
GEMINI_RPM=15
GEMINI_RPD=500
GEMINI_TPM=250000

# Retry policy for failed Gemini calls. Only transient failures (timeout,
# connection reset, 500/503) are retried — a malformed response is
# deterministic and moves straight to the next model. Every attempt takes a
# quota slot, so raising these raises worst-case daily spend.
# Attempts per model before falling through to the next one (1 = no retries).
GEMINI_MAX_ATTEMPTS=3
# Consecutive fully-failed batches before the run gives up on the LLM and
# leaves the remainder to the regex classifier.
GEMINI_MAX_BATCH_FAILURES=3
# Per-request deadline in seconds. A batch of 8 postings plus the resume is
# ~13k tokens, which can legitimately take over 90s to generate.
GEMINI_HTTP_TIMEOUT=150

# ── Impostor word game ────────────────────────────────────────────────────────
# Where /impostor reads and writes its word packs. One JSON object of
# "pack": ["word", ...] entries; edit it by hand for bulk additions (the bot
# reloads it automatically) or use /impostor words add|remove.
# Defaults to <repo>/data/impostor_words.json; a relative path here is
# resolved against the repo root, not the working directory.
#IMPOSTOR_WORDS_PATH=data/impostor_words.json
