{
  "name": "@baronchairstair/daily-puzzle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Daily modern-Tetris puzzle, playable as a Discord Activity.",
  "scripts": {
    "puzzles": "bun run tools/build-puzzles.ts",
    "review-link": "bun run tools/review-link.ts",
    "dev": "bun run --hot server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production bun run server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "sync-archive": "bun run tools/sync-archive.ts",
    "audit-archive": "bun run tools/audit-archive.ts",
    "rederive-clears": "bun run tools/rederive-flagged-clears.ts",
    "publish-archive": "bun run tools/publish-archive.ts"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.1.0",
    "@haelp/teto": "4.2.7",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "happy-dom": "^20.13.2",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
