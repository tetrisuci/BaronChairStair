# activity/.env — copy to .env and fill in.
# Only DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET / SESSION_SECRET are required,
# and only in production. Locally the activity runs with a guest identity.

# ── Discord application ───────────────────────────────────────────────────────
# From https://discord.com/developers/applications → your app → OAuth2.
# The client id is public (it is sent to the browser); the secret is not.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# Signs session tokens. Any long random string; `openssl rand -hex 32` is fine.
# Rotating it signs everyone out and kills every rush in progress, because a
# rush ticket is signed with it too and is the only record that a rush is open.
# Required in production; left unset, the server generates a random key per
# process and says so, and sessions simply do not survive a restart. There is no
# fixed fallback — a published default would let anyone forge a session for any
# player.
SESSION_SECRET=

# How long a session lasts before the activity re-authorises. Default 24.
#SESSION_TTL_HOURS=24

# Where the SQLite file lives. Defaults to activity/data/daily.sqlite.
#DATABASE_PATH=data/daily.sqlite

# ── Daily rotation ────────────────────────────────────────────────────────────
# IANA timezone the puzzle rolls over at midnight in. A named zone rather than a
# fixed offset, so the hour does not drift by one for the eight months of
# daylight saving. Validated at startup: a typo fails loudly rather than quietly
# rolling over at the wrong time for months. Defaults to America/Los_Angeles,
# where the club is.
#DAILY_RESET_TIMEZONE=America/Los_Angeles

# ── Discord bot access ────────────────────────────────────────────────────────
# Shared secret the bot presents to the activity: /api/recap for the daily
# recap, and /api/bot/reload-archive so /archive sync puts its new puzzles live
# without a restart (one whose board changed still waits for one). Leave it
# unset and every bot route (those two, /api/standings and /api/rush/standings)
# answers 404, switched off rather than left open: the recap never posts, and a
# sync waits for the next restart to go live.
# Must match PUZZLE_API_KEY in the bot's own .env.
#BOT_API_KEY=

# Set this to true when anything sits in front of this server — cloudflared,
# nginx, Caddy. It lets the rate limiter believe Cf-Connecting-Ip and
# X-Forwarded-For, which is how it tells one player from another behind a proxy.
#
# Leave it unset when the server is reachable directly. Those headers are
# written by whoever is talking to us, so trusting them where nothing rewrites
# them means a caller can mint a fresh rate-limit bucket per request and have no
# limit at all — including on the routes that replay a board through the engine.
#
# Unset in production, every player counts as one caller and they all share one
# bucket. That is the loud failure, on purpose: 429s get reported within the
# hour, where a bypassed limiter says nothing. The server warns at start-up.
#
# Defaults to on outside production, where there is no proxy and no attacker.
#TRUST_PROXY=true

# ── Puzzle review ─────────────────────────────────────────────────────────────
# Signs the links that let a club officer into the submission review queue.
# Any long random string; `openssl rand -hex 32` is fine. Leave it unset and the
# review routes answer 404 — switched off, not left open — which is why it is
# not required and why upgrading an existing deployment does not need it.
#
# Its own secret, never SESSION_SECRET. There is no way to revoke one link, so
# the only revocation is rotating this and restarting; sharing the session key
# would mean that act also signs out every player and kills every rush in
# progress, because a rush ticket is the only record that a rush is open.
# Rotating this one kills every review link and nobody else notices.
#
# `bun run review-link -- <who>` reads it straight from here (Bun loads this
# file when the command is run from activity/) and prints a link good for 15
# minutes. Anyone holding that link is a reviewer: spending it buys a two-hour
# sitting, so the worst case is 15 minutes plus two hours.
#REVIEW_SECRET=

# Public origin `review-link` prints its links against. Cosmetic: with it unset
# the command prints the path and says to put your host in front.
#REVIEW_BASE_URL=https://puzzle.example

# ── Set by the process manager, never here ────────────────────────────────────
# STATUS_FILE: an absolute path the game rewrites every 5 seconds with its state
# (starting, serving, draining, stopping) and counts only — duels, lobbies,
# recent rushes and players, requests in flight. Each game process needs a file
# of its own, and a second game started from this directory would read this
# file too, so it goes in the pm2 app's `env` or the systemd unit's
# `Environment=`. Unset, no file is written.
#
# BUILD_ID: which build this is. Unset, `bun run build` names the build after
# the checkout's commit, which is right on a git checkout. It changes with every
# release, so a value here would name every build alike.
#
# Both: DEPLOY.md, "Restarts and handovers".

# ── Development ───────────────────────────────────────────────────────────────
# Outside Discord there is no OAuth handshake, so a single local guest player
# stands in. It is on by default only when NODE_ENV is not production AND no
# Discord credentials are set — that is, on a bare checkout and nowhere else.
# Setting DISCORD_CLIENT_ID/SECRET turns it off, because that is what a real
# deployment looks like. Set it to "true" to force it on anyway, outside
# production only: under NODE_ENV=production nothing turns it on.
#ALLOW_GUEST_PLAY=true
