# activity/.env — copy to .env and fill in.
# Only DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET / SESSION_SECRET are required,
# and only in production. Locally the activity runs with a guest identity.

# ── Discord application ───────────────────────────────────────────────────────
# From https://discord.com/developers/applications → your app → OAuth2.
# The client id is public (it is sent to the browser); the secret is not.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# Signs session tokens. Any long random string; `openssl rand -hex 32` is fine.
# Rotating it signs everyone out, which is harmless. Required in production;
# left unset, the server generates a random key per process and says so, and
# sessions simply do not survive a restart. There is no fixed fallback — a
# published default would let anyone forge a session for any player.
SESSION_SECRET=

# How long a session lasts before the activity re-authorises. Default 24.
#SESSION_TTL_HOURS=24

# Where the SQLite file lives. Defaults to activity/data/daily.sqlite.
#DATABASE_PATH=data/daily.sqlite

# ── Daily rotation ────────────────────────────────────────────────────────────
# IANA timezone the puzzle rolls over at midnight in. A named zone rather than a
# fixed offset, so the hour does not drift by one for the eight months of
# daylight saving. Validated at startup: a typo fails loudly rather than quietly
# rolling over at the wrong time for months. Defaults to UTC.
#DAILY_RESET_TIMEZONE=America/Los_Angeles

# ── Discord bot access ────────────────────────────────────────────────────────
# Shared secret the bot presents to read a server's standings. Leave it unset
# and /api/standings is switched off entirely rather than left open.
# Must match PUZZLE_API_KEY in the bot's own .env.
#BOT_API_KEY=

# ── Development ───────────────────────────────────────────────────────────────
# Outside Discord there is no OAuth handshake, so a single local guest player
# stands in. It is on by default only when NODE_ENV is not production AND no
# Discord credentials are set — that is, on a bare checkout and nowhere else.
# Setting DISCORD_CLIENT_ID/SECRET turns it off, because that is what a real
# deployment looks like. Set it to "true" to force it on anyway.
#ALLOW_GUEST_PLAY=true
